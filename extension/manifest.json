{
  "manifest_version": 3,
  "name": "esuTABs",
  "version": "1.0.0",
  "description": "Open Source Knowledge, One Tab at a Time. Replace your New Tab with a premium, offline-first knowledge experience.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://www.linuxfoundation.org/*",
    "https://www.cncf.io/*",
    "https://www.openssf.org/*",
    "https://fedoramagazine.org/*",
    "https://www.debian.org/*",
    "https://kde.org/*",
    "https://planet.gnome.org/*",
    "https://www.suse.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
